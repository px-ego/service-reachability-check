# Copy required values into the Hermes home .env for production.
# A project-local .env is supported only for manual CLI validation.

FEISHU_APP_ID=<feishu-application-id>
FEISHU_APP_SECRET=<feishu-application-secret>
FEISHU_DOMAIN=feishu

SERVICE_REACHABILITY_ALERT_BOT_ID=<alert-bot-open-id>
SERVICE_REACHABILITY_ALERT_CHAT_ID=<alert-group-chat-id>
SERVICE_REACHABILITY_FEISHU_OWNER_OPEN_ID=<owner-open-id>

INTERNAL_PROBE_SSH_KEY_PATH=<absolute-private-key-path>
EXTERNAL_PROBE_SSH_KEY_PATH=<absolute-private-key-path>

# Optional legacy custom-bot webhook sender.
# FEISHU_WEBHOOK_URL=<custom-bot-webhook-url>
# FEISHU_SECRET=<custom-bot-signing-secret>
